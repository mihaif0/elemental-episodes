# Stripe — obține cheile din https://dashboard.stripe.com (folosește cheile de TEST la început)
# Copiază acest fișier în `.env.local` și completează valorile.

# Cheia secretă (server). Test: sk_test_...
STRIPE_SECRET_KEY=

# Secretul de webhook (din Stripe CLI sau dashboard). Test: whsec_...
STRIPE_WEBHOOK_SECRET=

# (Opțional) URL-ul public al site-ului, pentru imagini în Stripe Checkout și OG.
NEXT_PUBLIC_SITE_URL=
